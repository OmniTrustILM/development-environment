ILM_SOURCES_BASE_DIR=/dir/with/source/repositories
DB_HOST=postgres
# DB_HOST=host.docker.internal # use in case of connecting to Postgres installed on host machine
DB_PORT=5432
DB_HOST_PORT=2345
DB_USERNAME=ilmuser
DB_PASSWORD=your-strong-password
DB_NAME=ilm
# PostgreSQL SSL mode for services configured through JDBC_URL: disable | prefer | require | verify-ca | verify-full
# (services using other database settings are not affected)
DB_SSLMODE=disable
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
GITHUB_USERNAME=
GITHUB_PASSWORD=

# SoftHSM sidecar PINs.
SOFTHSM_USER_PIN=1234
SOFTHSM_SO_PIN=5678
